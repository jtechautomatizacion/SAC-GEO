# SAC-GEO — variables de entorno para desarrollo local
# Copiar a .env (NUNCA versionar .env con valores reales)
#
# POSTGRES_PASSWORD se deja VACIA a proposito. docker-compose.yml la exige con
# ${POSTGRES_PASSWORD:?...}, asi que copiar este archivo tal cual y levantar el
# contenedor falla con un mensaje claro en vez de arrancar con una contrasena
# que todo el mundo conoce. Un valor por defecto que funciona deja de ser un
# ejemplo: se convierte en la contrasena de todos, y queda versionada.

# --- PostgreSQL (desarrollo) ---
POSTGRES_DB=sacgeo_dev
POSTGRES_USER=sacgeo_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
