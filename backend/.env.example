# SAC-GEO backend — copiar a .env. NUNCA versionar .env con valores reales.
#
# NINGUN VALOR DE ESTE ARCHIVO ES FUNCIONAL. Todos son marcadores de posicion:
# copiado tal cual, el backend NO arranca. Es deliberado. Un archivo de ejemplo
# que funciona deja de ser un ejemplo y pasa a ser la configuracion de alguien
# — y entonces su contrasena, que esta versionada, se vuelve una credencial de
# verdad. Fue exactamente lo que le paso a este archivo: hasta la fase 6B.2 traia
# la credencial historica de desarrollo, funcional contra el cluster de trabajo.

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------
# La API se conecta como `sacgeo_app`: sin SUPERUSER, sin BYPASSRLS y sin poseer
# ninguna tabla. Su contrasena se genera en cada despliegue y vive solo en .env.
#
# NO poner aqui `sacgeo_dev`. Es superusuario: con el, ninguna politica de RLS
# llegaria a evaluarse, y con REQUIRE_RLS_SAFE_ROLE=true el arranque ABORTA.
DATABASE_URL=postgresql://sacgeo_app:GENERAR_Y_NO_VERSIONAR@localhost:5432/sacgeo_dev

POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
POOL_DISCARD_ALL=true

# ---------------------------------------------------------------------------
# MODO RLS SEGURO
# ---------------------------------------------------------------------------
# true  → antes de aceptar la primera peticion, la API comprueba que su rol de
#         conexion NO sea superusuario, NO tenga BYPASSRLS (ni heredados), NO
#         posea tablas de `public` y se llame exactamente ROL_APLICACION. Si
#         algo falla, ABORTA el arranque.
#
# false → solo advierte en el log y continua.
#
# `0004` esta aplicada en sacgeo_dev desde la fase 4B, asi que `sacgeo_app`
# existe y RLS esta forzada sobre 18 tablas. Desde ese momento **false NO es una
# configuracion valida**: dejaria las politicas creadas en el catalogo y sin
# efecto alguno, que es el peor de los tres estados posibles, porque parece
# seguro. Por eso el valor de ejemplo ya es true.
REQUIRE_RLS_SAFE_ROLE=true

# Rol con el que la API debe conectarse en modo seguro. Lo crea `0004`.
ROL_APLICACION=sacgeo_app

ENTORNO=desarrollo

# ---------------------------------------------------------------------------
# AUTENTICACION
# ---------------------------------------------------------------------------
# Generar uno propio:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA reutilizar este marcador como secreto real.
JWT_SECRET=GENERAR_UNO_PROPIO_NO_USAR_ESTE_VALOR
JWT_ALGORITMO=HS256
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7

# ---------------------------------------------------------------------------
# PRUEBAS
# ---------------------------------------------------------------------------
# La suite NO se configura desde aqui. Se apunta al cluster DESECHABLE con
# variables de entorno, porque el conftest crea y ELIMINA los roles sacgeo_app
# y sacgeo_auth, que en el cluster real son permanentes:
#
#   PG_CONTENEDOR=sac-geo-postgres-val PG_PUERTO=5433 PG_PASSWORD=<la del val>
#
# PG_PASSWORD no tiene valor por defecto a proposito: un valor por defecto en
# el repositorio es justo como nacio la credencial que hubo que retirar en 6B.2.
